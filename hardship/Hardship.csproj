<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Hardship</AssemblyName>
    <VersionPrefix>0.0.0</VersionPrefix>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
    <RootNamespace>Hardship</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!--
      Suppress internal MSBuild reference warnings:
      - MSB3245: Missing Unity modules (e.g., XR/VR) referenced by Jötunn but not required by this mod.
      - MSB3243: Version conflicts between Jötunn's NuGet packages and the game's native Unity DLLs.
      - MSB3277: Hidden internal dependencies required by assembly_valheim.dll (resolved by BepInEx at runtime).
    -->
    <MSBuildWarningsAsMessages>MSB3245;MSB3277;MSB3243</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!-- Generates a compile-time constant from VersionPrefix so the plugin version lives in one place. -->
  <Target Name="GeneratePluginVersionConstant" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <PluginVersionConstantsFile>$(IntermediateOutputPath)PluginVersion.g.cs</PluginVersionConstantsFile>
    </PropertyGroup>
    <ItemGroup>
      <PluginVersionConstantsLines Include="namespace Hardship%3B" />
      <PluginVersionConstantsLines Include="internal static partial class PluginInfo" />
      <PluginVersionConstantsLines Include="{" />
      <PluginVersionConstantsLines Include="    public const string PluginVersion = &quot;$(VersionPrefix)&quot;%3B" />
      <PluginVersionConstantsLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(PluginVersionConstantsFile)"
      Lines="@(PluginVersionConstantsLines)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(PluginVersionConstantsFile)" />
      <FileWrites Include="$(PluginVersionConstantsFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="BepInEx" Version="5.4.23.5" />
    <PackageReference Include="JotunnLib" Version="2.30.2" />
    <PackageReference Include="HarmonyX" Version="2.9.0" />
    <Reference  Include="UnityEngine">
      <HintPath>$(ValheimDir)/UnityEngine.dll</HintPath>
    </Reference >
    <Reference  Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimDir)/UnityEngine.CoreModule.dll</HintPath>
    </Reference >
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ValheimDir)/UnityEngine.PhysicsModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(ValheimDir)/UnityEngine.ParticleSystemModule.dll</HintPath>
    </Reference>
    <Reference  Include="assembly_valheim">
      <HintPath>$(ValheimDir)/assembly_valheim.dll</HintPath>
    </Reference >
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimDir)/assembly_utils.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
